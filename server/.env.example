# HomeBrain server environment

# HTTP port used by both the API and the production web UI.
PORT=3000

# MongoDB connection string
DATABASE_URL=mongodb://localhost/HomeBrain

# Optional MongoDB resource controls. The Linux/Jetson installer caps WiredTiger to 1 GB
# by default on ARM64 hosts; override it here before running setup-services if needed.
# HOMEBRAIN_MONGODB_WIREDTIGER_CACHE_GB=1.0
# MONGODB_MAX_POOL_SIZE=25
# MONGODB_MIN_POOL_SIZE=0
# MONGODB_MAX_CONNECTING=2

# Generate unique random secrets for every deployment.
# Example:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-secret
REFRESH_TOKEN_SECRET=replace-me-with-a-random-secret

# Optional: mark cookies as Secure when you are serving over HTTPS.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Authentication lifetime defaults. The installer generates secrets but leaves these defaults unless overridden.
AUTH_ACCESS_TOKEN_TTL=1h
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_SESSION_MAX_AGE_DAYS=30
AUTH_IOS_SESSION_MAX_AGE_DAYS=365

# Optional: public URL for browser redirects and OAuth callbacks.
# CLIENT_URL=https://homebrain.example.com

# Optional: comma-separated browser origins allowed to call the API with credentials.
# Same-origin requests and local Vite dev origins are handled automatically.
# CORS_ALLOWED_ORIGINS=https://homebrain.example.com,https://admin.example.com

# Optional: override the built-in Content-Security-Policy header.
# CONTENT_SECURITY_POLICY=

# Optional cloud providers
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STT_OPENAI_API_KEY=

# iOS push notifications (APNs)
HOMEBRAIN_APNS_TEAM_ID=
HOMEBRAIN_APNS_KEY_ID=
HOMEBRAIN_APNS_PRIVATE_KEY_PATH=
HOMEBRAIN_APNS_BUNDLE_ID=NTechR.HomeBrainApp
HOMEBRAIN_APNS_ENVIRONMENT=production
# Critical alerts require Apple approval for the critical-alert entitlement.
HOMEBRAIN_APNS_CRITICAL_ALERTS_ENABLED=false

# Optional: ElevenLabs API Base URL
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Optional SmartThings OAuth
# SMARTTHINGS_CLIENT_ID=
# SMARTTHINGS_CLIENT_SECRET=
# SMARTTHINGS_REDIRECT_URI=https://homebrain.example.com/api/smartthings/callback

# Optional legacy Ecobee App Key OAuth. The Settings Ecobee tab also supports
# no-App-Key account login with Ecobee email/password and MFA when required.
# ECOBEE_CLIENT_ID=
# ECOBEE_REDIRECT_URI=https://homebrain.example.com/api/ecobee/callback

# Caddy reverse-proxy integration
CADDY_ADMIN_URL=http://127.0.0.1:2019
ACME_ENV=staging

# Optional: public origin used for remote-device bootstrap links and webhook/callback URLs.
# Example:
# HOMEBRAIN_PUBLIC_BASE_URL=https://example.com
# HOMEBRAIN_EXPECTED_PUBLIC_IP=203.0.113.10
# HOMEBRAIN_EXPECTED_PUBLIC_IPV6=2001:db8::10

# Optional: bind host for the internal HomeBrain HTTP service.
# Leave at 0.0.0.0 if you still want direct LAN access on :3000.
# Set to 127.0.0.1 when all access goes through Caddy.
# HOMEBRAIN_BIND_HOST=0.0.0.0

# Optional default admin bootstrap.
# Existing matching accounts will be promoted to active admins automatically.
# To create the account automatically when it is missing, also set HOMEBRAIN_DEFAULT_ADMIN_PASSWORD.
# Existing admin passwords are left alone unless HOMEBRAIN_DEFAULT_ADMIN_SYNC_PASSWORD=true.
# HOMEBRAIN_DEFAULT_ADMIN_ENABLED=true
# HOMEBRAIN_DEFAULT_ADMIN_EMAIL=admin@example.com
# HOMEBRAIN_DEFAULT_ADMIN_NAME=HomeBrain Admin
# HOMEBRAIN_DEFAULT_ADMIN_PASSWORD=
# HOMEBRAIN_DEFAULT_ADMIN_SYNC_PASSWORD=false
