{
  "name": "homebrain-remote-device",
  "version": "1.3.11",
  "description": "HomeBrain Remote Voice Device for Linux listeners",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test *.test.js",
    "test:audio": "node test-audio.js",
    "install-deps": "npm ci --no-audit --no-fund && sudo apt-get update && sudo apt-get install -y alsa-utils pulseaudio",
    "setup-audio": "node setup-audio.js"
  },
  "keywords": [
    "voice",
    "smart-home",
    "raspberry-pi",
    "wake-word",
    "homebrain"
  ],
  "author": "HomeBrain",
  "license": "Apache-2.0",
  "dependencies": {
    "adm-zip": "0.6.1",
    "node-record-lpcm16": "^1.0.1",
    "node-wav": "^0.0.2",
    "onnxruntime-node": "1.30.0",
    "tflite-node": "1.0.0",
    "ws": "^8.21.1",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
